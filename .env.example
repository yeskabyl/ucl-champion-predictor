# Copy to `.env` (which is git-ignored) and fill in. Never commit a real token.
#
# Free football-data.org API token: https://www.football-data.org/client/register
# In Google Colab, prefer a Colab *secret* named FOOTBALL_DATA_API_TOKEN (key icon in the sidebar) instead of a file.
FOOTBALL_DATA_API_TOKEN=your-token-here

# Optional: log verbosity (DEBUG, INFO, WARNING)
# UCL_LOG_LEVEL=INFO
